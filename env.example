# ─────────────────────────────────────────────────────────────
# ReviewFunnel AI — Environment Variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored and never committed.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Get from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Google Places API ─────────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Enable: "Places API (New)" in API Library
# Free: $200/month credit (~11,700 searches). Requires billing account.
GOOGLE_PLACES_API_KEY=AIzaSy...

# ── OpenAI (Week 3 — not required for alpha) ─────────────────
# Get from: platform.openai.com → API Keys
# Leave blank until you're ready to replace hardcoded templates.
OPENAI_API_KEY=
